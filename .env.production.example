# Production settings. Create .env from this with:  sh bin/prod/make_env.sh your-domain you@example.com
APP_NAME="Osuthuru"
APP_ENV=production
APP_DEBUG=false
# The domain that points to this server, without https://
SITE_DOMAIN=
APP_URL=
# Long random text; used to scramble stored network addresses
APP_KEY=

DB_HOST=db
DB_PORT=3306
DB_NAME=osuthuru
DB_USER=app
DB_PASS=
DB_ROOT_PASS=
DB_ML_RO_USER=ml_ro
DB_ML_RO_PASS=

ADMIN_NAME="Osuthuru Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# A real mail service is required: new accounts must confirm their e-mail.
# Example (Gmail with an "app password"): smtp.gmail.com, 587, your address, the app password
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME="Osuthuru"

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash

ML_URL=http://ml:8000
