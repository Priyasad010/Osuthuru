# App Configuration
APP_NAME="Suwoda HerbHub V2"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database Configuration (Docker MySQL service 'db')
DB_HOST=db
DB_PORT=3306
DB_NAME=suwoda
DB_USER=app
DB_PASS=app_secret
DB_ROOT_PASS=root_secret

# Read-only user for ML service
DB_ML_RO_USER=ml_ro
DB_ML_RO_PASS=ml_ro_secret

# Initial Admin Setup (used by bin/create_admin.php)
ADMIN_NAME="Suwoda Administrator"
ADMIN_EMAIL=admin@suwoda.lk
ADMIN_PASSWORD=AdminSecurePass123!

# Mailpit (development mail catcher)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@suwoda.lk
MAIL_FROM_NAME="Suwoda HerbHub"

# Payment Gateways (Stripe & PayHere)
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=

# LLM AI Assistant
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Python Machine Learning Service
ML_URL=http://ml:8000
