# App Configuration
APP_NAME="Osuthuru"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database Configuration (Docker MySQL service 'db')
DB_HOST=db
DB_PORT=3306
DB_NAME=osuthuru
DB_USER=app
DB_PASS=app_secret
DB_ROOT_PASS=root_secret

# Read-only user for ML service
DB_ML_RO_USER=ml_ro
DB_ML_RO_PASS=ml_ro_secret

# Initial Admin Setup (used by bin/create_admin.php)
ADMIN_NAME="Osuthuru Administrator"
ADMIN_EMAIL=admin@osuthuru.lk
ADMIN_PASSWORD=AdminSecurePass123!

# Mailpit (development mail catcher)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@osuthuru.lk
MAIL_FROM_NAME="Osuthuru"

# Payment Gateways (Stripe & PayHere)
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
# true = test payments on sandbox.payhere.lk (set false only for a live merchant account)
PAYHERE_SANDBOX=true
# Only if PayHere must reach this shop on a different public address than APP_URL
PAYHERE_NOTIFY_URL=

# LLM AI Assistant
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Tried when the main model is busy or unavailable
LLM_FALLBACK_MODEL=gemini-3.5-flash

# Python Machine Learning Service
ML_URL=http://ml:8000
