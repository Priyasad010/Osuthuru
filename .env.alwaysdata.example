# Settings for alwaysdata shared hosting. Create .env with:  php bin/shared/setup_env.php
APP_NAME="Osuthuru"
APP_ENV=production
APP_DEBUG=false
APP_URL=
# Long random text; used to scramble stored network addresses
APP_KEY=

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

ADMIN_NAME="Osuthuru Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME="Osuthuru"

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash

# No Python service on this hosting: the shop uses its simpler PHP results
ML_URL=

# alwaysdata's proxy handles HTTPS and passes the visitor's address in this header
PROXY_IP_HEADER=X-Real-IP
